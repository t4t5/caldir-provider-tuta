+	#[test]
+	fn decrypt_empty_optional_encrypted_value_as_null() {
+		let sk = GenericAesKey::Aes256(Aes256Key::from_bytes(KNOWN_SK.as_slice()).unwrap());
+		let type_model_provider = Arc::new(TypeModelProvider::new_test(
+			Arc::new(MockRestClient::new()),
+			Arc::new(MockFileClient::new()),
+			"localhost:9000".to_string(),
+		));
+		let type_model = type_model_provider
+			.resolve_server_type_ref(&CalendarEvent::type_ref())
+			.unwrap();
+		let entity_facade = EntityFacadeImpl::new(
+			Arc::clone(&type_model_provider),
+			RandomizerFacade::from_core(rand_core::OsRng),
+		);
+		let json_serializer = JsonSerializer::new(type_model_provider.clone());
+		let encrypted = entity_facade
+			.encrypt_and_map(
+				&type_model,
+				&create_test_entity_dict::<CalendarEvent>(),
+				&sk,
+			)
+			.unwrap();
+		let mut raw_event = json_serializer
+			.serialize(&CalendarEvent::type_ref(), encrypted)
+			.unwrap();
+		let start_time_zone_id: String = type_model
+			.get_attribute_id_by_attribute_name("startTimeZone")
+			.unwrap()
+			.into();
+		raw_event.insert(
+			start_time_zone_id.clone(),
+			JsonElement::String(String::new()),
+		);
+
+		let parsed_event = json_serializer
+			.parse(&CalendarEvent::type_ref(), raw_event)
+			.unwrap();
+		let decrypted_event = entity_facade
+			.decrypt_and_map(
+				&type_model,
+				parsed_event,
+				ResolvedSessionKey {
+					session_key: sk,
+					owner_enc_session_key: vec![0, 1, 2],
+					owner_key_version: 0,
+					sender_identity_pub_key: None,
+				},
+			)
+			.unwrap();
+
+		assert_eq!(
+			Some(&ElementValue::Null),
+			decrypted_event.get(&start_time_zone_id)
+		);
+	}
